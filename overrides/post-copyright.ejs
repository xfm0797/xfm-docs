<%#
  站点层覆盖：themes/xfm/layout/_partials/post/copyright.ejs
  —— 唯一改动是输出 licenseText 的那一行：由「转义输出」改为「原始输出」。
  （注意：本注释里不要出现任何 EJS 起始标记，否则注释会被提前截断。）
  主题的 copyright_text 支持 {link} 占位符，替换结果是超链接标签；
  转义输出会把标签变成页面上可见的字面文本，必须原样输出才是真链接。
  主题修复该行后，本文件与 scripts/copyright-view.js 可一并删除。
%>
<%
  const licenseText = (theme.post && theme.post.copyright_text) || __('post.copyright');
  const pageUrl = decodeURI(full_url_for(page.path || ''));
%><div class="post-copyright">
  <div class="copyright-author">
    <% if (theme.avatar) { %><img src="<%= url_for(theme.avatar) %>" alt="<%= page.author || config.author %>"><% } %>
    <div>
      <strong><%= page.author || config.author %></strong>
      <span><%= date(page.date, 'YYYY-MM-DD') %></span>
    </div>
  </div>
  <p class="copyright-text">
    <%- licenseText.replace('{link}', '<a href="' + pageUrl + '">' + (page.title || config.title) + '</a>') %>
  </p>
  <div class="copyright-meta">
    <span><svg class="xfm-icon" aria-hidden="true"><use xlink:href="#xfm-i-link"></use></svg><a href="<%= pageUrl %>"><%= pageUrl %></a></span>
  </div>
</div>
