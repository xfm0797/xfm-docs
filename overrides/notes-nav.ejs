<%
/**
 * 站点级覆盖：笔记侧栏导航（_partials/notes/nav.ejs）
 *
 * 背景
 *   1. 主题原生 xfm_notes_nav() 把「全站文章」全部列进笔记侧栏，本站 20 篇文章
 *      会被全量列出，与「归档」页完全重复；本站约定「笔记」= 更新日志类记录，
 *      需要按分类（note_categories）/ 标签（note_tags）过滤后再成列表。
 *   2. 主题的 notes 形态只在 mode 为 notes 的页面上出现侧栏，文章默认走 blog 形态，
 *      从笔记列表点进单篇后左侧导航会消失。因此笔记类文章的 front-matter 统一标注
 *      mode: notes（见 source/notes/index.md 的说明），侧栏得以常驻。
 *
 * 注入方式：scripts/notes-view.js 在 before_generate 阶段用 hexo.theme.setView() 覆盖。
 * 沿用主题的 class 命名（.xfm-notes-nav / .xfm-nav-group / .xfm-nav-link …），
 * 因此主题与站点补丁的既有样式全部继续生效；不改主题 submodule。
 *
 * 可配置项（站点 _config.yml → theme_config.notes）：
 *   note_categories  只收录这些分类下的文章（空数组 = 不按分类过滤）
 *   note_tags        只收录带这些标签的文章（空数组 = 不按标签过滤）
 *   group_by         分组方式：none（不分组，默认）/ category / date
 *   sort_by / order  组内排序字段与方向：date / title / order，asc / desc
 *   show_date        条目是否显示日期
 *   search           侧栏顶部是否显示搜索按钮
 */
const cfg = theme.notes || {};
const noteCats = (cfg.note_categories || []).filter(Boolean);
const noteTags = (cfg.note_tags || []).filter(Boolean);
const groupBy = cfg.group_by || 'none';
const sortBy = cfg.sort_by || 'date';
const order = cfg.order === 'asc' ? 1 : -1;
const showDate = cfg.show_date !== false;
const searchOnSidebar = cfg.search !== false;

function normPath(p) {
  let s = String(p || '').trim();
  if (!s) return '';
  if (s.charAt(0) !== '/') s = '/' + s;
  // pretty URL 下 page.path 形如 2026/10/11/slug/index.html，与导航里的 /2026/10/11/slug/ 归一
  s = s.replace(/index\.html$/i, '').replace(/\.html$/i, '/');
  if (s.length > 1 && s.charAt(s.length - 1) !== '/') s += '/';
  return s;
}

function namesOf(coll) {
  return coll && coll.data ? coll.data.map(function (x) { return x.name; }) : [];
}

function dateOf(p, fmt) {
  if (p.date && p.date.format) return p.date.format(fmt);
  return String(p.date).slice(0, 10);
}

const current = normPath(page.path);
const all = site.posts && site.posts.data ? site.posts.data : [];

// 只保留「笔记」：按分类 / 标签过滤，二者同时配置时取交集
const notes = all.filter(function (p) {
  if (!p.title) return false;
  if (noteCats.length) {
    const cats = namesOf(p.categories);
    if (!cats.some(function (c) { return noteCats.indexOf(c) > -1; })) return false;
  }
  if (noteTags.length) {
    const tags = namesOf(p.tags);
    if (!tags.some(function (t) { return noteTags.indexOf(t) > -1; })) return false;
  }
  return true;
});

const sorted = notes.slice().sort(function (a, b) {
  if (sortBy === 'title') return order * String(a.title).localeCompare(String(b.title));
  if (sortBy === 'order') return order * ((a.order || 9999) - (b.order || 9999));
  return order * (new Date(a.date) - new Date(b.date));
});

// groups = [[组名, 条目数组], …]；group_by: none 时用空组名表示「不渲染组头」
let groups;
if (groupBy === 'none') {
  groups = [['', sorted]];
} else {
  const map = new Map();
  sorted.forEach(function (p) {
    let key = '未分组';
    if (groupBy === 'category') {
      const cats = namesOf(p.categories);
      key = cats.length ? cats.join(' / ') : '未分组';
    } else {
      key = dateOf(p, 'YYYY-MM');
    }
    if (!map.has(key)) map.set(key, []);
    map.get(key).push(p);
  });
  groups = Array.from(map.entries());
}
%><div class="site-nav-head">
  <svg class="xfm-icon" aria-hidden="true"><use xlink:href="#xfm-i-book"></use></svg>
  <span><%= __('notes.sidebar') %></span>
</div>
<% if (searchOnSidebar && theme.search && theme.search.enable !== false) { %>
<button class="site-nav-search" type="button" data-toggle="search">
  <svg class="xfm-icon" aria-hidden="true"><use xlink:href="#xfm-i-search"></use></svg>
  <span><%= __('search.placeholder') %></span>
  <kbd>Ctrl K</kbd>
</button>
<% } %>
<% if (!notes.length) { %>
<div class="xfm-nav-empty"><%= __('notes.empty_group') %></div>
<% } else { %>
<nav class="xfm-sidebar-nav xfm-notes-nav">
  <div class="xfm-notes-count"><%= __('notes.total_notes', notes.length) %></div>
  <% groups.forEach(function (entry) {
    const key = entry[0];
    const list = entry[1];
    const open = list.some(function (p) { return normPath(p.path) === current; });
  %>
  <div class="xfm-nav-group<%= open ? ' is-open' : '' %>">
    <% if (key) { %>
    <div class="xfm-nav-group-head">
      <span class="xfm-nav-group-title"><%= key %></span>
      <span class="xfm-nav-group-count"><%= list.length %></span>
      <i class="xfm-arrow"></i>
    </div>
    <% } %>
    <ul class="xfm-nav-list depth-1">
      <% list.forEach(function (p) {
        const active = normPath(p.path) === current;
      %>
      <li class="xfm-nav-item<%= active ? ' is-active' : '' %>">
        <a class="xfm-nav-link<%= active ? ' is-active' : '' %>" href="<%= url_for(p.path) %>"<%= active ? ' aria-current="page"' : '' %>>
          <span class="xfm-nav-link-title"><%= p.title %></span>
          <% if (showDate) { %><span class="xfm-nav-link-date"><%= dateOf(p, 'MM-DD') %></span><% } %>
        </a>
      </li>
      <% }); %>
    </ul>
  </div>
  <% }); %>
</nav>
<% } %>
